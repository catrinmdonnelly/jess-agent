# Jess — environment variables

# ─── REQUIRED ───────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your-anthropic-api-key-here
GEMINI_API_KEY=your-gemini-api-key-here

# Image hosting — Cloudinary OR WordPress, at least one required.
# Cloudinary is simpler for most users.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_UPLOAD_PRESET=

# Instagram (must be a Business or Creator account, connected to a Facebook page)
META_INSTAGRAM_ACCOUNT_ID=
META_PAGE_ACCESS_TOKEN=

# ─── BRAND CUSTOMISATION ────────────────────────────────────────────────────
BUSINESS_NAME=Your Business Name
INSTAGRAM_HANDLE=@yourbusiness

# Hex colours used on the slide-1 hook card.
# Defaults: ink navy / warm off-white / soft coral.
BRAND_BG_COLOR=#1a2332
BRAND_TEXT_COLOR=#f5efe6
BRAND_ACCENT_COLOR=#eba18a

# Override the display font with any variable-weight TTF on a public URL.
# Defaults to Playfair Display from Google Fonts.
# FONT_REGULAR_URL=
# FONT_ITALIC_URL=

# ─── RECOMMENDED ────────────────────────────────────────────────────────────
ANTHROPIC_MODEL=claude-opus-4-6
AGENT_TIMEZONE=Europe/London

# What hour each phase runs in your local timezone.
# Defaults: plan at 08, post at 12, post at 18.
JESS_PLAN_HOUR=8
JESS_SLOT1_HOUR=12
JESS_SLOT2_HOUR=18

# ─── OPTIONAL — fallback image generator ────────────────────────────────────
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1

# ─── OPTIONAL — WordPress as image host fallback ────────────────────────────
WP_SITE_URL=
WP_USERNAME=
WP_PASSWORD=

# ─── OPTIONAL — failure email alerts ────────────────────────────────────────
FAILURE_EMAIL_TO=
FAILURE_EMAIL_FROM=
FAILURE_EMAIL_SMTP_HOST=smtp.gmail.com
FAILURE_EMAIL_SMTP_PASS=

# ─── OPTIONAL — testing modes ───────────────────────────────────────────────
# Force a specific phase regardless of the current hour: plan, publish_slot_1, publish_slot_2
# JESS_MODE=
# Plan only, do not generate images or post — useful before going live.
# JESS_PLAN_ONLY=true
